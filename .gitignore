examples/demo-density/audio/narration-asr.json
examples/demo-density/audio/bgm.wav
# 渲染临时目录（保留成片与抽帧）
examples/demo-density/qc/
# 15 风格横跑的输入（小文本，CI 直接引用，必须进仓）
examples/demo-density/sweep/*
