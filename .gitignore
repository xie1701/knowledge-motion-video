# Dependencies
node_modules/
# package-lock.json IS tracked (CI uses `npm ci` for a reproducible renderer install)

# Renders and scratch (whitelist example outputs for the style gallery)
examples/*/renders/*
!examples/*/renders/visual-master.mp4
!examples/*/renders/style-loop.gif
!examples/sample-project/renders/final-demo.mp4
.hf-tmp/
frames_tmp/
*.pyc
__pycache__/

# OS
.DS_Store

# Showcase regenerable intermediates (reproduce via mix_audio.py / ffmpeg)
examples/showcase-project/audio/mix.wav
examples/showcase-project/renders/qc-frames/
examples/showcase-project/renders/qc-final/
!examples/showcase-project/renders/final-showcase.mp4
!examples/demo-density/renders/final-density.mp4
!examples/demo-density/renders/contact-sheet.jpg
